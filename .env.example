# Copy this file to .env and fill in your values (.env must never be committed)

# LLM used by src/llm.py: hf
LLM_PROVIDER=hf

# Hugging Face token (huggingface.co > Settings > Access Tokens,
# permission "Make calls to Inference Providers")
HUGGINGFACEHUB_API_TOKEN=hf_xxx

# Model called through the Hugging Face Inference Providers
HF_MODEL_ID=openai/gpt-oss-20b

# URL of the API called by the Streamlit interface
API_URL=http://localhost:8000
